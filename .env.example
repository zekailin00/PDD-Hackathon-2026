# Copy to .env and fill in. Never commit the result.
# Participant model API keys are NOT set here -- each person adds their own in the UI.

GITHUB_TOKEN=
GITHUB_REPO=zekailin00/PDD-Hackathon-2026
GITHUB_BASE_BRANCH=main
MEM0_API_KEY=

# Seed new rooms with a worked example (default on). Set 0 to disable.
SEED_ROOMS=1

# Enables POST /api/rooms/{id}/demo-proposal for rehearsing the vote flow.
ALLOW_DEMO_SEED=0

# House key -- lets a visitor try a room without bringing their own key.
# A participant's own key always wins over this one.
# SET THIS IN RENDER'S DASHBOARD, NEVER IN A FILE. This repo is public.
FALLBACK_API_KEY=
FALLBACK_PROVIDER=tokenrouter
